<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:property name="base_length" value="0.25" />
    <xacro:property name="base_width" value="0.25" />
    <xacro:property name="base_height" value="0.4" />
    <xacro:property name="base_mass" value="30" />

    <xacro:property name="wheel_radius" value="0.03" />
    <xacro:property name="wheel_width" value="0.015" />
    <xacro:property name="wheel_pos_x" value="0.09" />
    <xacro:property name="wheel_pos_y" value="0.09" />
    <xacro:property name="wheel_pos_z" value="-0.2" />
    <xacro:property name="wheel_mass" value="0.01" />
    <xacro:property name="wheel_torque" value="16" />

    <xacro:property name="depth_sensor_pose">
        <origin xyz="0.14 0 0.25" rpy="0 ${pi/3} 0"/>
    </xacro:property>
</robot>